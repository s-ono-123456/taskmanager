{{define "page"}}
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<title>タスク管理ダッシュボード（パイロット）</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="/static/htmx.min.js"></script>
<style>
  [draggable="true"] { cursor: grab; }
  [draggable="true"]:active { cursor: grabbing; }
  dialog::backdrop { background: rgba(15, 23, 42, 0.5); }
</style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 min-h-screen">
<div class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8">

  <h1 class="text-xl font-semibold tracking-tight mb-4">
    タスク管理ダッシュボード
    <span class="text-sm font-normal text-slate-400">（パイロット・外部通信なし）</span>
  </h1>

  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 rounded-xl bg-white dark:bg-slate-800 shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 px-4 py-3">
    <form id="filter-state" method="get"
          hx-get="/" hx-select="#board" hx-target="#board" hx-swap="outerHTML" hx-push-url="true" hx-trigger="change"
          class="flex flex-wrap items-center gap-3 text-sm">
      <label class="flex items-center gap-1.5">
        対象:
        <select name="target"
                class="rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 text-sm py-1 pl-2 pr-7 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          <option value="">(すべて)</option>
          {{range .Targets}}
            <option value="{{.}}" {{if eq . $.SelectedTarget}}selected{{end}}>{{.}}</option>
          {{end}}
        </select>
      </label>
      <label class="flex items-center gap-1.5">
        <input type="checkbox" name="show_untracked" value="1" {{if .ShowUntracked}}checked{{end}}
               class="rounded border-slate-300 text-blue-600 focus:ring-blue-500">
        非表示分も表示
      </label>
    </form>
    <div class="flex items-center gap-2">
      <button type="button" id="close-requests-btn"
         class="rounded-md bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-100 px-3 py-1.5 text-sm font-medium ring-1 ring-slate-300 dark:ring-slate-600 hover:bg-slate-50 dark:hover:bg-slate-600 transition-colors shadow-sm">
        クローズ要求
        {{template "closeRequestsCount" .}}
      </button>
      <button type="button" id="new-task-btn"
         class="rounded-md bg-blue-600 text-white px-3 py-1.5 text-sm font-medium hover:bg-blue-700 transition-colors shadow-sm">
        + 新規タスク
      </button>
    </div>
  </div>

  {{template "board" .}}
</div>

<dialog id="edit-modal" class="rounded-xl shadow-lg p-0 w-full max-w-lg bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 backdrop:backdrop-blur-sm">
  <form method="post" id="edit-form" hx-target="#board" hx-swap="outerHTML"
        hx-vals="js:{...filterStateVals()}"
        class="p-5 space-y-4">
    <div class="flex items-start justify-between gap-2">
      <h2 class="text-lg font-semibold">タスク詳細</h2>
      <span id="edit-info-id" class="text-xs text-slate-400 mt-1"></span>
    </div>

    <label class="block text-sm font-medium">
      タイトル
      <input type="text" name="title" id="edit-title" required
             class="mt-1 block w-full rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
    </label>
    <label class="block text-sm font-medium">
      説明
      <textarea name="description" id="edit-description" rows="4"
                class="mt-1 block w-full rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
    </label>
    <div class="grid grid-cols-3 gap-3">
      <label class="block text-sm font-medium">
        期限
        <input type="date" name="due_date" id="edit-due-date"
               class="mt-1 block w-full rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
      </label>
      <label class="block text-sm font-medium">
        対象
        <select name="target" id="edit-target"
                class="mt-1 block w-full rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          {{range .Targets}}
            <option value="{{.}}">{{.}}</option>
          {{end}}
        </select>
      </label>
      <label class="block text-sm font-medium">
        状態
        <select name="status" id="edit-status"
                class="mt-1 block w-full rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          {{range .Statuses}}
            <option value="{{.}}">{{statusLabel .}}</option>
          {{end}}
        </select>
      </label>
    </div>

    <dl class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs bg-slate-50 dark:bg-slate-900/40 rounded-lg p-3">
      <dt class="text-slate-500 dark:text-slate-400">週の所属</dt>
      <dd id="edit-info-cycle" class="text-slate-700 dark:text-slate-200"></dd>
      <dt class="text-slate-500 dark:text-slate-400">JIRA連携</dt>
      <dd id="edit-info-jira" class="text-slate-700 dark:text-slate-200"></dd>
      <dt class="text-slate-500 dark:text-slate-400">表示状態</dt>
      <dd id="edit-info-tracked" class="text-slate-700 dark:text-slate-200"></dd>
      <dt class="text-slate-500 dark:text-slate-400">作成日時</dt>
      <dd id="edit-info-created" class="text-slate-700 dark:text-slate-200"></dd>
      <dt class="text-slate-500 dark:text-slate-400">完了日時</dt>
      <dd id="edit-info-closed" class="text-slate-700 dark:text-slate-200"></dd>
      <dt class="text-slate-500 dark:text-slate-400">最終同期(JIRA)</dt>
      <dd id="edit-info-synced" class="text-slate-700 dark:text-slate-200"></dd>
    </dl>

    <div id="edit-info-message" class="hidden text-xs bg-slate-50 dark:bg-slate-900/40 rounded-lg p-3">
      <div class="font-medium text-slate-600 dark:text-slate-300 mb-1">元発言</div>
      <div id="edit-info-message-meta" class="text-slate-500 dark:text-slate-400"></div>
      <div id="edit-info-message-text" class="mt-1 whitespace-pre-wrap text-slate-700 dark:text-slate-200"></div>
    </div>

    <div class="flex justify-end gap-2 pt-1">
      <button type="button" id="edit-cancel"
              class="rounded-md px-4 py-2 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
        キャンセル
      </button>
      <button type="submit"
              class="rounded-md bg-blue-600 text-white px-4 py-2 text-sm font-medium hover:bg-blue-700 transition-colors shadow-sm">
        保存
      </button>
    </div>
  </form>
</dialog>

<dialog id="new-task-modal" class="rounded-xl shadow-lg p-0 w-full max-w-md bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 backdrop:backdrop-blur-sm">
  <form method="post" id="new-task-form" action="/tasks/new"
        hx-post="/tasks/new" hx-target="#board" hx-swap="outerHTML"
        hx-vals="js:{...filterStateVals()}"
        class="p-5 space-y-4">
    <h2 class="text-lg font-semibold">新規タスク</h2>
    <p class="text-xs text-slate-500">
      対象がjira_a/jira_bの場合でも、このパイロットでは実際のJIRA起票は行いません
      （ログにスタブ出力するのみ）。状態は「未着手」で作成されます。
    </p>
    <label class="block text-sm font-medium">
      タイトル
      <input type="text" name="title" id="new-task-title" required
             class="mt-1 block w-full rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
    </label>
    <label class="block text-sm font-medium">
      説明
      <textarea name="description" id="new-task-description" rows="4"
                class="mt-1 block w-full rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
    </label>
    <label class="block text-sm font-medium">
      期限
      <input type="date" name="due_date" id="new-task-due-date"
             class="mt-1 block w-full rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
    </label>
    <label class="block text-sm font-medium">
      対象
      <select name="target" id="new-task-target"
              class="mt-1 block w-full rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        {{range .Targets}}
          <option value="{{.}}">{{.}}</option>
        {{end}}
      </select>
    </label>
    <div class="flex justify-end gap-2 pt-1">
      <button type="button" id="new-task-cancel"
              class="rounded-md px-4 py-2 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
        キャンセル
      </button>
      <button type="submit"
              class="rounded-md bg-blue-600 text-white px-4 py-2 text-sm font-medium hover:bg-blue-700 transition-colors shadow-sm">
        追加
      </button>
    </div>
  </form>
</dialog>

<dialog id="close-requests-modal" class="rounded-xl shadow-lg p-0 w-full max-w-lg bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 backdrop:backdrop-blur-sm">
  <div class="p-5 space-y-4">
    <div class="flex items-start justify-between gap-2">
      <h2 class="text-lg font-semibold">クローズ要求一覧</h2>
      <button type="button" id="close-requests-cancel"
              class="rounded-md px-3 py-1.5 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
        閉じる
      </button>
    </div>
    <p class="text-xs text-slate-500">
      完了報告らしき候補です。承認すると対象タスクを完了扱いにします（JIRA連携タスクは
      実際のJIRA通信を行わずログにスタブ出力するのみ）。却下すると一覧から消えます。
    </p>
    {{template "closeRequests" .}}
  </div>
</dialog>

<script src="/static/board.js"></script>

{{template "toast" .}}
</body>
</html>
{{end}}

{{define "board"}}
<div id="board" class="flex flex-col gap-6">
  {{$today := .Today}}
  {{range $lane := .Lanes}}
  <div class="lane-row rounded-xl bg-slate-100/60 dark:bg-slate-900/30 p-3 pb-8" data-lane="{{$lane}}">
    <h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-2 px-1">
      {{index $.LaneLabels $lane}}
    </h2>
    <div class="flex gap-4 items-stretch overflow-x-auto">
      {{range $status := $.Statuses}}
      {{$cards := index (index $.Columns $lane) $status}}
      <div class="column flex flex-col flex-1 min-w-[260px] min-h-[10rem] rounded-xl bg-white dark:bg-slate-800 shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 transition-colors"
           data-status="{{$status}}" data-lane="{{$lane}}">
        <div class="flex items-center gap-2 px-3 pt-3 pb-2 border-b-2 {{accentBarClass $status}} border-opacity-70 rounded-t-xl">
          <h3 class="font-semibold text-sm">{{statusLabel $status}}</h3>
          <span class="text-xs font-medium rounded-full px-2 py-0.5 {{accentPillClass $status}}">
            {{len $cards}}
          </span>
          {{if eq $status "done"}}
          <span class="text-xs text-white/80">(直近{{$.DoneWindowDays}}日以内に完了)</span>
          {{end}}
        </div>
        <div class="flex-1 p-3 space-y-3">
          {{range $card := $cards}}
          <div class="card group rounded-lg bg-white dark:bg-slate-900/60 shadow-sm
                      hover:shadow-md hover:ring-blue-300 dark:hover:ring-blue-600 hover:-translate-y-0.5 transition-all
                      p-2.5 text-sm cursor-pointer flex items-start gap-2
                      {{if eq $card.Status "done"}}opacity-60{{end}}
                      {{if not $card.Tracked}}opacity-60 border-2 border-dashed border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800/60{{else}}ring-1 ring-slate-200 dark:ring-slate-700{{end}}"
               draggable="true" data-task-id="{{$card.ID}}"
               data-title="{{$card.Title}}"
               data-description="{{$card.Description}}"
               data-target="{{$card.Target}}"
               data-status="{{$card.Status}}"
               data-cycle="{{$card.CycleStartDate}}"
               data-jira-key="{{$card.JiraKey}}"
               data-tracked="{{if $card.Tracked}}1{{else}}0{{end}}"
               data-created-at="{{$card.CreatedAt}}"
               data-closed-at="{{$card.ClosedAt}}"
               data-last-synced-at="{{$card.LastSyncedAt}}"
               data-due-date="{{$card.DueDate}}"
               data-msg-source="{{$card.MsgSource}}"
               data-msg-channel="{{$card.MsgChannel}}"
               data-msg-author="{{$card.MsgAuthor}}"
               data-msg-text="{{$card.MsgText}}"
               data-msg-received-at="{{$card.MsgReceivedAt}}">
            <div class="min-w-0 flex-1">
              <div class="font-medium truncate {{if eq $card.Status "done"}}line-through text-slate-400{{end}}">
                {{$card.Title}}
              </div>
              <div class="flex flex-wrap items-center gap-1.5 mt-1 text-xs">
                <span class="inline-block rounded-full px-2 py-0.5 {{targetPillClass $card.Target}}">
                  {{$card.Target}}
                </span>
                {{if not $card.Tracked}}
                <span class="inline-block font-medium rounded-full px-2 py-0.5 border border-dashed border-slate-400 text-slate-500 dark:text-slate-400">
                  非表示中
                </span>
                {{end}}
                {{if $card.DueDate}}
                <span class="inline-block rounded-full px-2 py-0.5 font-medium
                             {{if isOverdue $card.DueDate $today $card.Status}}bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-200{{else}}bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300{{end}}">
                  {{$card.DueDate}}
                </span>
                {{end}}
              </div>
            </div>
            <form hx-post="/tasks/{{$card.ID}}/track" hx-target="#board" hx-swap="outerHTML"
                  hx-vals="js:{...filterStateVals()}"
                  class="card-actions shrink-0">
              <button type="submit"
                      title="{{if $card.Tracked}}非表示にする{{else}}再表示する{{end}}"
                      aria-label="{{if $card.Tracked}}非表示にする{{else}}再表示する{{end}}"
                      class="rounded p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 dark:hover:text-slate-200 dark:hover:bg-slate-700 transition-colors">
                {{if $card.Tracked}}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/>
                  <circle cx="12" cy="12" r="3"/>
                  <line x1="3" y1="3" x2="21" y2="21"/>
                </svg>
                {{else}}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
                {{end}}
              </button>
            </form>
          </div>
          {{else}}
          <p class="text-xs text-slate-400 text-center py-6">タスクなし</p>
          {{end}}
        </div>
      </div>
      {{end}}
    </div>
  </div>
  {{end}}
</div>
{{end}}

{{define "toast"}}
<div id="toast-container" hx-swap-oob="true">
  {{if .Toast}}
  <div class="fixed inset-x-0 bottom-0 z-50 pointer-events-none">
    <div class="max-w-7xl mx-auto px-4 pb-4 sm:px-6 lg:px-8 space-y-2">
      <div class="pointer-events-auto rounded-lg px-4 py-2 text-sm shadow-lg {{if eq .Toast.Category "success"}}bg-emerald-100 text-emerald-800 dark:bg-emerald-900/90 dark:text-emerald-200{{else}}bg-rose-100 text-rose-800 dark:bg-rose-900/90 dark:text-rose-200{{end}}">
        {{.Toast.Message}}
      </div>
    </div>
  </div>
  {{end}}
</div>
{{end}}

{{define "closeRequestsCount"}}<span id="close-requests-count" hx-swap-oob="true" class="inline-block ml-1 rounded-full bg-slate-200 dark:bg-slate-600 text-xs px-1.5 py-0.5">{{len .CloseRequests}}</span>{{end}}

{{define "closeRequests"}}
<div id="close-requests-container" hx-swap-oob="true" class="space-y-3">
  {{if not .CloseRequests}}
  <p class="text-xs text-slate-400 text-center py-6">承認待ちのクローズ要求はありません</p>
  {{end}}
  {{range $req := .CloseRequests}}
  <div class="rounded-lg ring-1 ring-slate-200 dark:ring-slate-700 p-3 text-sm space-y-2">
    <div class="flex flex-wrap items-center gap-1.5 text-xs">
      <span class="inline-block rounded-full px-2 py-0.5 {{targetPillClass $req.Target}}">{{$req.Target}}</span>
      {{if $req.RelatedJiraKey}}
      <span class="inline-block rounded-full px-2 py-0.5 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">
        {{$req.RelatedJiraKey}}
      </span>
      {{end}}
      <span class="text-slate-400">confidence {{printf "%.2f" $req.Confidence}}</span>
    </div>
    <div class="font-medium">{{$req.Summary}}</div>
    {{if $req.MsgText}}
    <div class="text-xs bg-slate-50 dark:bg-slate-900/40 rounded-lg p-2">
      <div class="text-slate-500 dark:text-slate-400">
        {{$req.MsgSource}} ・ {{$req.MsgChannel}} ・ {{$req.MsgAuthor}} ・ {{$req.MsgReceivedAt}}
      </div>
      <div class="mt-1 whitespace-pre-wrap text-slate-700 dark:text-slate-200">{{$req.MsgText}}</div>
    </div>
    {{end}}
    <form hx-post="/candidates/{{$req.ID}}/approve" hx-target="#board" hx-swap="outerHTML"
          hx-vals="js:{...filterStateVals()}"
          class="flex flex-wrap items-center gap-2">
      {{if not $req.RelatedJiraKey}}
      <select name="task_id" required
              class="rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-700 text-sm py-1 pl-2 pr-7 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        <option value="">対象タスクを選択</option>
        {{range $opt := $req.OpenTasks}}
          <option value="{{$opt.ID}}">{{$opt.Title}}</option>
        {{end}}
      </select>
      {{end}}
      <button type="submit"
              class="rounded-md bg-blue-600 text-white px-3 py-1 text-xs font-medium hover:bg-blue-700 transition-colors">
        承認
      </button>
    </form>
    <form hx-post="/candidates/{{$req.ID}}/reject" hx-target="#board" hx-swap="outerHTML"
          hx-vals="js:{...filterStateVals()}">
      <button type="submit"
              class="rounded-md px-3 py-1 text-xs font-medium text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
        却下
      </button>
    </form>
  </div>
  {{end}}
</div>
{{end}}

{{define "boardAndToast"}}{{template "board" .}}{{template "toast" .}}{{template "closeRequests" .}}{{template "closeRequestsCount" .}}{{end}}
